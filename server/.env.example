# server/.env.example
# 复制此文件为 .env，填入真实的 Key

# ── 必填 ────────────────────────────────────────────────────────
# DeepSeek API Key（对话模型）
# 申请地址：https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# ── 可选 ────────────────────────────────────────────────────────
# OpenAI API Key（embedding 模型，RAG 功能需要）
# 如果不做 RAG 功能可以不填
OPENAI_API_KEY=sk-your-openai-key-here

# 服务端口（默认 3000）
PORT=3000

# 运行环境：development / production
NODE_ENV=development

# 允许跨域的前端地址（多个用逗号分隔）
ALLOWED_ORIGINS=http://localhost:5173

# 使用的对话模型（默认 deepseek-v4-flash）
PRIMARY_MODEL=deepseek-v4-flash

# DeepSeek v4 思考模式（可选）
# - enabled: 开启思考（更强推理，通常更慢/更贵）
# - disabled: 关闭思考（近似旧 deepseek-chat 行为）
# 留空则对 deepseek-v4-* 默认 disabled；其它模型不发送该字段
DEEPSEEK_THINKING_TYPE=enabled

# 推理强度（可选）：low / medium / high
# 通常在 DEEPSEEK_THINKING_TYPE=enabled 时配合使用
# 留空则不发送该字段
DEEPSEEK_REASONING_EFFORT=high

# 使用的 Embedding 模型（SiliconFlow OpenAI 兼容）
EMBED_BASE_URL=https://api.siliconflow.cn/v1
EMBED_MODEL=BAAI/bge-large-zh-v1.5

# Chroma 向量数据库地址（RAG 功能需要启动 Chroma）
# 启动命令：docker run -d -p 8006:8000 chromadb/chroma
CHROMA_URL=http://localhost:8006

# 缓存过期时间（毫秒，默认 30 分钟）
CACHE_TTL=1800000
